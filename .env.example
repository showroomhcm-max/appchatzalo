# Cổng máy chủ (web + API cùng một cổng)
PORT=3000

# Thư mục lưu database SQLite, cookie Zalo, file tải lên. Nhớ sao lưu thư mục này.
# DATA_DIR=./data

# Khóa ký token đăng nhập. Để trống sẽ tự tạo và lưu trong DATA_DIR.
# JWT_SECRET=

# Tài khoản quản trị tạo lần đầu. Để trống ADMIN_PASSWORD sẽ sinh ngẫu nhiên
# và ghi vào DATA_DIR/admin-initial-password.txt
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Các domain web app khác được gọi API từ trình duyệt (CORS), cách nhau dấu phẩy. Trống = cho phép tất cả.
# CORS_ORIGINS=https://crm.example.com,https://admin.example.com

# Đăng nhập bằng tài khoản Odoo (giống các app SieuToc khác)
ODOO_URL=https://erp.sieutoc.com
ODOO_DB=SieuToc
# Tài khoản Odoo tự động được duyệt làm quản trị viên (cách nhau dấu phẩy).
# Người khác đăng nhập lần đầu sẽ ở trạng thái "Chờ duyệt" trong trang Nhân viên.
ODOO_ADMINS=

# Link cố định khi đã có tên miền qua Cloudflare Tunnel (hiển thị trong app để gửi nhân viên)
# PUBLIC_URL=https://cskhzalo.sieutoc.com
