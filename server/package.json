{
  "name": "zalo-cskh-server",
  "version": "3.27.0",
  "description": "Backend Zalo CSKH đa nhân viên",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "seed:demo": "tsx --env-file-if-exists=../.env src/seed-demo.ts"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "zca-js": "^2.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
